{
  "version": 1,
  "enabled": true,
  "repository_id": "beargallbladder/outcitedharness",
  "owner": "self",
  "data_use": "shadow_learning",
  "authorization_scope": "owned_repository_cursor_shadow",
  "teacher_model": "gpt-5.6-sol",
  "local_model_key": "asus2_qwen",
  "allowed_paths": [
    "harness/**",
    "scripts/**",
    "tests/**",
    "config/*.yaml",
    "deploy/**",
    "*.md",
    "pyproject.toml",
    ".gitignore"
  ],
  "excluded_paths": [
    ".env",
    ".env.*",
    ".git",
    ".harness-shadow",
    ".harness-shadow.json",
    ".cursor/hooks.json",
    ".cursor/hooks/**",
    ".venv",
    "**/.env",
    "**/.env.*",
    "**/.git/**",
    "**/.harness-shadow/**",
    "**/.venv/**",
    "**/credentials.json",
    "**/node_modules/**",
    "**/secrets.*",
    "config/learning-connectors.yaml",
    "results/**"
  ],
  "max_prompt_chars": 60000,
  "max_dirty_patch_bytes": 5000000,
  "max_untracked_file_bytes": 512000,
  "max_untracked_total_bytes": 5000000,
  "max_agent_turns": 8,
  "max_context_chars": 80000,
  "max_attempts": 3
}
