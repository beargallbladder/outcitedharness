# Copy to .env and fill only the keys you actually use.
# Disabled providers do not need credentials.

# L2 DeepSeek + primary L3 MiniMax via OpenRouter
OPENROUTER_API_KEY=

# Backup L3 MiniMax via Together (disabled unless OpenRouter MiniMax fails)
TOGETHER_API_KEY=

# L4 frontier — Anthropic (native)
ANTHROPIC_API_KEY=

# Optional second L4 — OpenAI (native)
OPENAI_API_KEY=

# Unused by the harness today
HF_TOKEN=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
FRONTIER_API_KEY=
