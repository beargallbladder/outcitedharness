# Non-secret topology and storage defaults. Copy to a host-local file and edit.
# Do not put HF_TOKEN or other credentials in this file.
DGX2_TRAINING_ROOT=/home/samkim2/harness-training
ASUS1_SCRATCH_ROOT=/home/samkimasus1/harness-training

# 4 TB is decimal drive capacity. Scratch protection is 250 GiB, in bytes.
DGX2_MIN_CAPACITY_BYTES=4000000000000
ASUS1_MIN_FREE_BYTES=268435456000

# DGX2 is authoritative for all durable inputs and outputs.
HF_HOME=/home/samkim2/harness-training/cache/huggingface
HUGGINGFACE_HUB_CACHE=/home/samkim2/harness-training/cache/huggingface/hub
TRANSFORMERS_CACHE=/home/samkim2/harness-training/cache/huggingface/transformers
HF_DATASETS_CACHE=/home/samkim2/harness-training/cache/huggingface/datasets
TORCH_HOME=/home/samkim2/harness-training/cache/torch
TORCH_EXTENSIONS_DIR=/home/samkim2/harness-training/cache/torch/extensions
XDG_CACHE_HOME=/home/samkim2/harness-training/cache/xdg

# Direct-link values are examples and must match the actual link before launch.
TRAINING_LINK_INTERFACE=enp65s0f0
TRAINING_LINK_MTU=9000
TRAINING_MASTER_ADDR=10.77.0.1
TRAINING_MASTER_PORT=29500
